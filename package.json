{
  "name": "review",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "postinstall": "pnpm --filter @review/desktop exec install-electron",
    "predev": "pnpm --filter @review/contracts build && pnpm --filter @review/codex-app-server build",
    "dev": "concurrently -k -n server,desktop -c blue,magenta \"pnpm --filter @review/local-server dev\" \"pnpm --filter @review/desktop dev\"",
    "build": "pnpm --filter @review/contracts build && pnpm --filter @review/codex-app-server build && pnpm --filter @review/local-server build && pnpm --filter @review/desktop build",
    "lint": "oxlint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/node": "26.4.1",
    "concurrently": "10.0.5",
    "oxlint": "1.81.0",
    "typescript": "6.0.3"
  }
}
